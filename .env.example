# EVE SSO application (developers.eveonline.com)
EVE_CLIENT_ID=your_client_id
EVE_CLIENT_SECRET=your_client_secret
EVE_CALLBACK_URL=http://localhost:8080/callback

# 32-byte AES key as 64 hex chars. Generate:
#   PowerShell: -join ((1..32) | %% { '{0:x2}' -f (Get-Random -Max 256) })
#   Linux:      openssl rand -hex 32
ENCRYPTION_KEY=

# Optional overrides
#LISTEN_ADDR=:8080
#DB_PATH=eve-empire.db
#SDE_PATH=sde.db
#ESI_USER_AGENT=eve-empire/0.1 (contact: you@example.com)
#EVE_SCOPES=publicData esi-wallet.read_character_wallet.v1 ...
