# EVE Empire: настройки службы (systemd EnvironmentFile, без кавычек и export).
# Файл читают root и группа eve-empire: здесь секрет SSO и ключ шифрования.
# После правки: systemctl restart eve-empire

# Приложение EVE SSO с developers.eveonline.com. Callback в приложении должен
# совпадать с EVE_CALLBACK_URL ниже, иначе логин не пройдёт.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:8080/callback

# 32 байта в hex (64 символа): openssl rand -hex 32
# Им зашифрованы refresh-токены в базе. Потеряешь ключ, все альты перелогиниваются.
ENCRYPTION_KEY=

LISTEN_ADDR=:8080
DB_PATH=/var/lib/eve-empire/eve-empire.db
SDE_PATH=/var/lib/eve-empire/sde.db
TZ=UTC

# Фоновый сбор данных для учёта ТМЦ (по умолчанию включён). Вторая копия
# рядом с основной ставит off, чтобы не удваивать трафик к ESI.
#COLLECTOR=off

# ESI Refresher: full (по умолчанию) держит кэш тёплым, demand обновляет
# только ручки открытых страниц.
#REFRESHER=demand

# Кто может завести НОВЫЙ кабинет, войдя незнакомым персонажем:
# first (по умолчанию) — только первый вход в пустую базу, open — любой,
# closed — никто (вход только уже добавленными), corp — этап 5, пока = closed.
#SIGNUP=first

# Срок жизни сессии (кука eve_session) в днях.
#SESSION_DAYS=90

# ESI просит представляться: укажи, как с тобой связаться.
#ESI_USER_AGENT=eve-empire/0.1 (contact: you@example.com)

# Не задавай без нужды: код запрашивает ровно нужные scopes, а полный
# список EVE (72 штуки) ломает логин.
#EVE_SCOPES=
